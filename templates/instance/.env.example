COMPOSE_PROJECT_NAME=
MIXTUM_SOURCE=
SECRET_KEY=
AUTH_MODE=keycloak
SETTINGS_ENV=local
DEBUG=1
USE_S3=0
AWS_QUERYSTRING_AUTH=1
POSTGRES_DB=mixtumdb
POSTGRES_USER=mixtumuser
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8080
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/mixtum
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/mixtum/protocol/openid-connect/certs
KEYCLOAK_REALM=mixtum
KEYCLOAK_API_AUDIENCE=mixtum-api
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
CORS_ALLOW_CREDENTIALS=true
