# Docker Compose — nome progetto (auto-generato da setup.sh, NON modificare a mano)
# Determina il prefisso di container e volumi: ogni cartella/istanza ha il suo.
COMPOSE_PROJECT_NAME=

# Django Settings
DJANGO_SETTINGS_MODULE=mixtum_core.settings
SETTINGS_ENV=local
MIXTUM_COMPOSITION_MODULE=mixtum_instance.composition
AUTH_MODE=django
# Solo con AUTH_MODE=keycloak e profilo Compose oidc (ambiente locale).
# Il client Console è pubblico: nessun client secret nel frontend.
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8080
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/mixtum
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/mixtum/protocol/openid-connect/certs
KEYCLOAK_REALM=mixtum
KEYCLOAK_API_AUDIENCE=mixtum-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
SECRET_KEY=
DEBUG=1
REMOTE_API=1
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
CELERY_LOG_LEVEL=info

# Prod Only
SERVER_NAME=tuodominio.it
CERTBOT_EMAIL=you@example.com

# DB
POSTGRES_DB=mixtumdb
POSTGRES_USER=mixtumuser
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Porta su macOS per DBeaver/psql verso il container (se 5432 è già usata da un altro stack: es. 5433)
POSTGRES_HOST_PORT=5432
# Idem per Redis da host (es. 6380 se 6379 è occupata)
REDIS_HOST_PORT=6379

# Celery/Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
TIME_ZONE=Europe/Rome

# Security
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4300,http://127.0.0.1:4300
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4300,http://127.0.0.1:4300
CORS_ALLOW_CREDENTIALS=true

# AWS S3
USE_S3=0
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-south-1
AWS_QUERYSTRING_AUTH=1
# Opzionali
# AWS_S3_CUSTOM_DOMAIN=dxxxxxx.cloudfront.net
# AWS_S3_ENDPOINT_URL=  # per MinIO/Spaces, altrimenti lascia vuoto
# AWS_MEDIA_LOCATION=media
# AWS_STATIC_LOCATION=static

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# n8n Integration
N8N_BASE_URL=https://n8n.yourdomain.com
N8N_API_KEY=your-n8n-api-key
# Twilio WhatsApp Integration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
# Opzionale: salta validazione firma in DEBUG mode
TWILIO_SKIP_SIGNATURE_VALIDATION=0
