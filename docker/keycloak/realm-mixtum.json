{
  "realm": "mixtum",
  "displayName": "AI 4 ISO 27001 & NIS2",
  "enabled": true,
  "registrationAllowed": false,
  "loginTheme": "mixtum",
  "internationalizationEnabled": true,
  "supportedLocales": ["it", "en"],
  "defaultLocale": "it",
  "clients": [
    {
      "clientId": "mixtum-console",
      "name": "AI 4 ISO 27001 & NIS2 Console (local development)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:4200/",
        "http://localhost:4200/"
      ],
      "webOrigins": [
        "http://127.0.0.1:4200",
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["web-origins", "roles", "profile", "email", "basic"],
      "protocolMappers": [
        {
          "name": "mixtum-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mixtum-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mixtum-public",
      "name": "AI 4 ISO 27001 & NIS2 Public Frontend (local development)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:4300/",
        "http://localhost:4300/"
      ],
      "webOrigins": [
        "http://127.0.0.1:4300",
        "http://localhost:4300"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["web-origins", "roles", "profile", "email", "basic"],
      "protocolMappers": [
        {
          "name": "mixtum-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mixtum-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
